# Copy this file to .env and fill in your values before running docker compose up.

# Required: Anthropic API key (passed through to agent containers at spawn time)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Docker image name for agent containers.
# Build it first: docker build -t computer-use-agent:local -f Dockerfile.agent .
AGENT_IMAGE=computer-use-agent:local

# Optional overrides (defaults shown)
# IDLE_TTL_SECONDS=3600      # seconds before an idle session container is reaped
